{
  "name": "local-markdown-reader",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Browse local folders and read Markdown in your browser.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:browser": "node scripts/check-mermaid.mjs",
    "icons:import": "node scripts/import-azure-icons.mjs",
    "icons:import-entra": "node scripts/import-entra-icon.mjs",
    "licenses:generate": "node scripts/dependency-licenses.mjs",
    "licenses:check": "node scripts/dependency-licenses.mjs --check"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "dom-serializer": "^3.1.1",
    "htmlparser2": "^12.0.0",
    "marked": "^17.0.0",
    "mermaid": "^12.2.0",
    "sanitize-html": "^2.17.0"
  }
}
